# ============================================================
# API KEYS
# ============================================================
# Clés principales (optionnelles selon provider)
GROQ_API_KEY=your_groq_key_here # https://console.groq.com/keys
GOOGLE_API_KEY=your_google_key_here # https://aistudio.google.com/apikey
DEEPSEEK_API_KEY=your_deepseek_key_here

# Compatibilité providers payants (optionnel)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# ============================================================
# AGENTIC RAG PROVIDERS (chatbot_agentic_rag_ui.py)
# ============================================================
# Providers supportés: groq|gemini|deepseek|openai|anthropic
PRERETRIEVAL_PROVIDER=gemini
GENERATION_PROVIDER=groq
CRITIQUE_PROVIDER=gemini

# Models par étape
PRERETRIEVAL_MODEL=gemini-1.5-flash
GENERATION_MODEL=llama-3.3-70b-versatile
CRITIQUE_MODEL=gemini-1.5-flash

# Réglages qualité/richesse de réponse Agentic
AGENTIC_TOP_K=10
AGENTIC_FINAL_TOP_N=7
AGENTIC_RETRIEVAL_SCORE_THRESHOLD=0.20
AGENTIC_CRITIQUE_THRESHOLD=5.5
AGENTIC_MAX_CONTEXT_CHARS=3500

# DeepSeek (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# CONFIGURATION RAG
# ============================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_STORE_TYPE=faiss

# ============================================================
# COMPATIBILITÉ CHATBOT RAG SIMPLE (chatbot_avec_rag_simple.py)
# ============================================================
LLM_PROVIDER=ollama
LLM_MODEL=phi3:mini

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO
